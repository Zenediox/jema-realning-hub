<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>JEMA LEARNING HUB</title>
  <style>
    body {
      background: #808080;
      margin: 0;
      font-family: Arial, sans-serif;
      min-height: 100vh;
      width: 100vw;
      box-sizing: border-box;
      position: relative;
      overflow-x: hidden;
    }
    #background-study-img {
      position: fixed;
      left: 0;
      top: 0;
      width: 100vw;
      height: 100vh;
      background: url('https://images.unsplash.com/photo-1513258496099-48168024aec0?auto=format&fit=crop&w=1350&q=80') no-repeat center center;
      background-size: cover;
      z-index: 0;
    }
    #background-study-img.overlay {
      background-color: rgba(90,90,90,0.5);
      background-blend-mode: darken;
    }
    #background-overlay {
      position: fixed;
      left: 0; top: 0;
      width: 100vw; height: 100vh;
      background: rgba(120,120,120,0.45);
      z-index: 1;
    }
    #main {
      margin-left: 120px;
      max-width: 700px;
      padding: 34px 25px 120px 25px;
      min-height: 70vh;
      position: relative;
      z-index: 10;
    }
    /* Left Navigation Bar Styles (large) */
    #left-navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 108px;
      height: 100vh;
      background: #111;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      z-index: 101;
      padding-top: 45px;
      gap: 22px;
    }
    .nav-btn {
      width: 93px;
      height: 82px;
      margin: 0;
      padding: 14px 0 2px 0;
      background: #111;
      color: #fff;
      border: none;
      border-radius: 18px;
      cursor: pointer;
      font-weight: bold;
      font-size: 1.38rem;
      line-height: 1.62em;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      transition: background 0.2s, color 0.2s, border 0.2s;
      letter-spacing: .9px;
      box-shadow: 0 2px 12px #0008;
      text-align: center;
      min-height: 77px;
    }
    .nav-btn .nav-icon {
      font-size: 2.2em;
      margin-bottom: 0px;
      display: block;
      line-height: 1.2em;
    }
    .nav-btn .nav-label {
      font-size: 1.11em;
      margin-top: 0px;
      display: block;
      letter-spacing: .7px;
    }
    .nav-btn:hover, .nav-btn.active {
      background: #fff;
      color: #111;
      border: 2px solid #111;
      box-shadow: 0 2px 16px #fff3;
    }

    .site-title-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      min-height: 350px;
      margin-top: 120px;
      user-select: none;
      z-index: 30;
      position: relative;
    }
    .site-title {
      text-align: center;
      font-family: Impact, Elephant, Arial Black, Arial, sans-serif;
      font-weight: 900;
      text-transform: uppercase;
      font-size: 3.15em;
      color: #222;
      letter-spacing: .13em;
      margin-bottom: 32px;
      margin-top: 0;
      text-shadow:
        2px 2px 0 #fff3e7,
        4px 4px 0 #888,
        0 8px 24px #0004;
      line-height: 1.07;
    }
    .about-label {
      text-align: center;
      font-size: 1.32em;
      font-weight: bold;
      letter-spacing: .09em;
      color: #222;
      margin-bottom: 18px;
      margin-top: 2px;
      text-shadow: 0 0 6px #fff2, 0 1px 0 #2222;
    }
    .about-desc {
      text-align: center;
      color: #222;
      font-size: 1.13em;
      margin-bottom: 18px;
      margin-top: 0px;
      max-width: 540px;
      line-height: 1.5em;
    }
    .vertical-levels {
      margin: 0 auto 20px auto;
      text-align: center;
    }
    .vertical-levels span {
      display: block;
      margin: 7px 0;
      color: #111;
      font-size: 1.16em;
      font-weight: bold;
      letter-spacing: .12em;
      padding: 4px 0;
    }
    .vertical-levels span:before, .vertical-levels span:after {
      content: "(";
      color: #111;
      font-weight: bold;
      margin-right: 2px;
    }
    .vertical-levels span:after {
      content: ")";
      margin-left:2px;
      margin-right: 0;
    }
    .hidden { display: none !important; }
    h2 { margin-top: 0; color: #111; font-weight: 700;}
    .note {
      margin-bottom: 15px;
      background: rgba(255,255,255,0.93);
      padding: 15px;
      border-radius: 8px;
      box-shadow: 0 3px 9px #b3750060;
      position: relative;
    }
    .form-box { margin: 35px auto 0 auto; background: #f4f4f4; padding: 24px 30px; border-radius: 16px; box-shadow: 0 2px 16px #aaa3; max-width: 370px; display: flex; flex-direction: column;}
    .form-box input { margin-bottom: 16px; padding: 11px; border-radius: 9px; border: 1.3px solid #bbb; font-size: 1.02rem;}
    .form-box button { padding: 13px 0; background: #111; color: #fff; border-radius: 10px; font-size: 1.07rem; font-weight: bold; border: none; margin-bottom: 10px;}
    .form-box button:hover { background: #fff; color: #111; border: 2px solid #111;}
    .form-box .error { color: #e04b47; font-weight: bold; margin-bottom: 10px;}
    .form-box .success { color: #42a820; font-weight: bold; margin-bottom: 10px;}
    .user-table { margin-top: 16px; border-collapse: collapse; width: 340px; max-width: 95vw; background: #fff;}
    .user-table th, .user-table td { border: 1px solid #aaa; padding: 12px 5px; text-align: center; font-size: 1rem;}
    .user-table th { background: #e6e6e6; font-weight: bold;}
    .footer {
      position: fixed;
      left: 0;
      bottom: 0;
      width: 100vw;
      background: #222;
      color: #fff;
      font-size: 1.11em;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 40px;
      padding: 18px 10px 18px 120px;
      z-index: 9999;
      letter-spacing: .06em;
    }
    .footer .footer-icon { vertical-align: middle; margin-right: 7px; margin-left: 7px; display: inline-block; height: 1.3em; width: 1.32em;}
    .footer a { color: #fff; text-decoration: none; font-weight: bold; transition: color 0.2s;}
    .footer a:hover { color: #6fbf7b; }

    @media (max-width: 900px) {
      #main {margin-left: 110px;}
      .footer { padding-left: 90px; gap: 24px;}
      #left-navbar {width: 88px;}
    }
    @media (max-width: 700px) {
      #main {margin-left: 75px; padding: 6px 7px 150px 7px;}
      .site-title { font-size: 2em;}
      #left-navbar { width: 55px;}
      .site-title-container { min-height: 180px;}
      .footer {padding-left: 55px; gap: 17px;}
    }
    @media (max-width: 450px) {
      #main { min-width: unset;}
      .site-title { font-size: 1.1em;}
      #left-navbar { width: 37px;}
      .nav-btn {width: 63px; height:47px; font-size:.99em;}
      .form-box, .user-table { max-width: 95vw; }
      .site-title-container { min-height: 85px;}
      .about-label{ font-size:.96em;}
      .about-desc{font-size:.93em;}
      .vertical-levels span{font-size:.97em;}
      .footer { font-size:.89em; gap: 7px; padding-left: 40px;}
    }
  </style>
</head>
<body>
  <!-- Background photo and overlay, only on home page -->
  <div id="background-study-img" class="overlay"></div>
  <div id="background-overlay"></div>
  <!-- Left Nav Bar -->
  <div id="left-navbar">
    <button id="home-btn" class="nav-btn active"><span class="nav-icon">⌂</span><span class="nav-label">Home</span></button>
    <button id="login-btn" class="nav-btn"><span class="nav-icon">⏎</span><span class="nav-label">Login</span></button>
    <button id="register-btn" class="nav-btn"><span class="nav-icon">✍</span><span class="nav-label">Register</span></button>
    <button id="admin-btn" class="nav-btn"><span class="nav-icon">🛡</span><span class="nav-label">Admin</span></button>
  </div>
  <!-- Main Content -->
  <div id="main">
    <!-- Front Page: Title, About, Teacher Note Info -->
    <div id="student-title-bar" class="site-title-container">
      <div class="site-title">JEMA LEARNING HUB</div>
      <div class="about-label">ABOUT</div>
      <div class="about-desc">
        teachers notes in all courses this include mineral porocessing and information and communication technology in all level
      </div>
      <div class="vertical-levels">
        <span>level 4</span>
        <span>level 5</span>
        <span>level 6</span>
      </div>
    </div>
    <!-- Student Notes Page -->
    <div id="student-page" class="hidden">
      <h2>Download Notes</h2>
      <div id="notes-list"></div>
    </div>
    <!-- Login form -->
    <div id="login-page" class="hidden">
      <div class="form-box">
        <h2>Student Login</h2>
        <input id="student-username" placeholder="Username">
        <input id="student-password" type="password" placeholder="Password">
        <button onclick="studentLogin()">Sign in</button>
        <div id="student-error" class="error"></div>
      </div>
    </div>
    <!-- Registration form -->
    <div id="register-page" class="hidden">
      <div class="form-box">
        <h2>New Student Registration</h2>
        <input id="register-username" placeholder="Choose username" />
        <input id="register-password" type="password"  placeholder="Choose password (leave empty if desired)"/>
        <button onclick="registerUser()">Register</button>
        <div id="register-error" class="error"></div>
        <div id="register-success" class="success"></div>
      </div>
    </div>
    <!-- Admin Login Page -->
    <div id="admin-login-page" class="hidden">
      <div class="form-box">
        <h2>Admin Login</h2>
        <input type="text" id="admin-username" placeholder="Admin username" />
        <input type="password" id="admin-password" placeholder="Admin password" />
        <button onclick="adminLogin()">Login</button>
        <div id="admin-login-msg" class="error"></div>
      </div>
    </div>
    <!-- Admin Panel -->
    <div id="admin-panel" class="hidden">
      <h2>Admin Panel</h2>
      <button onclick="adminLogout()" class="logout-btn" style="margin-bottom: 16px;">Log out</button>
      <h3>Add Note</h3>
      <form id="add-note-form" onsubmit="event.preventDefault();addNote();">
        <input id="note-title" placeholder="Note title" required>
        <input id="note-link" placeholder="Download link (e.g. PDF)" required>
        <button type="submit">Add Note</button>
      </form>
      <h3>Approve Notes</h3>
      <div id="admin-notes-list"></div>
      <h3>Registered Users</h3>
      <table id="admin-users-list" class="user-table"></table>
    </div>
  </div>
  <!-- Footer Info Bar -->
  <div class="footer">
    <!-- WhatsApp -->
    <span>
      <svg class="footer-icon" viewBox="0 0 24 24" fill="#25d366" xmlns="http://www.w3.org/2000/svg"><path d="M12.005 2C6.472 2 2.005 6.474 2.005 12c0 2.034.55 3.99 1.589 5.72l-1.5 4.359c-.099.29-.021.607.197.824.147.146.352.223.552.223.089 0 .178-.015.264-.046l4.521-1.421c1.639.844 3.476 1.293 5.384 1.293C17.535 22 22.005 17.526 22.005 12c0-5.527-4.467-10-10-10zm0 18c-1.763 0-3.497-.411-5.07-1.194a1.001 1.001 0 00-.821-.052l-3.508 1.104.993-2.886a.999.999 0 00-.106-.807C4.168 17.172 3.005 14.68 3.005 12c0-4.962 4.041-9 9-9s9 4.038 9 9c0 4.963-4.042 9-9 9zm5.038-6.256c-.296-.15-1.756-.865-2.028-.966-.272-.102-.471-.151-.67.15-.2.299-.769.965-.941 1.167-.172.203-.346.228-.642.078-.297-.149-1.254-.463-2.388-1.479-.884-.79-1.48-1.761-1.654-2.059-.172-.299-.019-.454.131-.605.134-.135.299-.348.447-.522.147-.174.197-.299.297-.498.099-.199.049-.373-.024-.522-.075-.15-.671-1.62-.92-2.221-.242-.583-.489-.504-.671-.514-.172-.011-.372-.011-.573-.011-.202 0-.522.075-.796.373-.273.298-.905.879-.905 2.138 0 1.258.929 2.477 1.091 2.656.162.179 2.181 3.257 5.282 4.529.739.289 1.314.462 1.763.592.74.221 1.415.191 1.946.115.594-.088 1.798-.733 2.053-1.442.174-.468.174-.868.123-1.008-.051-.139-.191-.22-.389-.319z"/></svg>
      <a href="https://wa.me/252612228725" target="_blank">0612228725</a>
    </span>
    <!-- Instagram -->
    <span>
      <svg class="footer-icon" viewBox="0 0 24 24" fill="#d6249f" xmlns="http://www.w3.org/2000/svg"><path d="M16.998 2.617c2.636.003 4.381.133 5.377 1.128.991.991 1.126 2.742 1.13 5.378v6.472c-.004 2.635-.139 4.386-1.13 5.377-.995.995-2.74 1.125-5.377 1.128h-6.472c-2.635-.003-4.382-.133-5.377-1.128-.991-.991-1.126-2.742-1.13-5.378V9.123c.004-2.635.139-4.386 1.13-5.377.995-.995 2.742-1.125 5.377-1.128h6.472zm0-1.617H9.123c-2.952.003-5.089.16-7.08 2.152C.158 5.091.001 7.224.001 10.17v3.658c0 2.947.157 5.08 2.042 6.964C3.806 22.837 5.939 22.997 8.87 22.997h6.257c2.952-.003 5.089-.16 7.08-2.152C23.842 18.91 24 16.777 24 13.831v-3.658c0-2.947-.158-5.08-2.043-6.964C20.193 1.163 18.061 1.003 15.13 1.003zm.627 3.462c1.052.003 1.897.013 2.553.278a2.525 2.525 0 011.142 1.14c.264.654.276 1.501.278 2.553v6.471c-.002 1.052-.014 1.899-.278 2.553a2.534 2.534 0 01-1.142 1.141c-.654.264-1.501.276-2.553.278h-6.471c-1.053-.003-1.899-.014-2.553-.278a2.525 2.525 0 01-1.142-1.14C4.373 16.538 4.361 15.691 4.359 14.638v-6.472c.003-1.052.013-1.899.278-2.553a2.525 2.525 0 011.142-1.14c.654-.264 1.501-.276 2.553-.278h6.471zm-3.313 2.101a5.628 5.628 0 100 11.257 5.628 5.628 0 000-11.257zm0 9.252a3.627 3.627 0 110-7.254 3.627 3.627 0 010 7.254zm7.29-8.265a1.276 1.276 0 11-2.553 0 1.276 1.276 0 012.553 0z"/></svg>
      <a href="https://www.instagram.com/jema_institute_of_technology" target="_blank">jema institute of technology</a>
    </span>
    <!-- Gmail -->
    <span>
      <svg class="footer-icon" viewBox="0 0 24 24" fill="#ea4335" xmlns="http://www.w3.org/2000/svg"><path d="M22.5 6.5l-9 7.5-9-7.5V6.5c0-1.105.895-2 2-2h14c1.105 0 2 .895 2 2v.004zm-18 1.6v10.4c0 1.104.896 2 2 2h14c1.104 0 2-.896 2-2V8.1l-8.84 7.36a1.001 1.001 0 01-1.32 0L4.5 8.1zm16 11.4h-14c-1.654 0-3-1.346-3-3V6.5c0-1.654 1.346-3 3-3h14c1.654 0 3 1.346 3 3V16.5c0 1.654-1.346 3-3 3z"/></svg>
      <a href="mailto:zenediox@gmail.com" target="_blank">zenediox@gmail.com</a>
    </span>
  </div>
<script>
  // Simulated database
  let notes = [
    {title: "Lecture 1: Introduction", link: "https://example.com/note1.pdf", approved: true},
    {title: "Offline USB Network Project Proposal", link: "Offline_USB_Network_Project_Proposal.pdf", approved: true}
  ];
  let users = [{username: "student", password: "student"}];
  let loggedInStudent = null;
  let adminLoggedIn = false;
  const ADMIN_USERNAME = "zenediox";
  const ADMIN_PASSWORD = "haroun";
  function showPage(page) {
    ["student-title-bar","student-page","login-page","register-page","admin-login-page","admin-panel"]
      .forEach(pid=>document.getElementById(pid).classList.add("hidden"));
    document.getElementById("background-study-img").style.display = (page==="home") ? "" : "none";
    document.getElementById("background-overlay").style.display = (page==="home") ? "" : "none";
    setActiveBtn(page);
    if(page==="home"){
      document.getElementById("student-title-bar").classList.remove("hidden");
    }
    else if(page==="student-page") {
      document.getElementById("student-page").classList.remove("hidden");
      showNotes();
    } else {
      document.getElementById(page).classList.remove("hidden");
      if(page==="admin-panel"){ showAdminNotes(); showAdminUsers(); }
      else if(page==="student-page"){ showNotes(); }
    }
    ["student-error","register-error","register-success","admin-login-msg"].forEach(id=>{
      let el=document.getElementById(id);if(el)el.innerHTML="";
    });
  }
  function setActiveBtn(page) {
    let btnList = [
      {id:"home-btn",chk:"home"},
      {id:"login-btn",chk:"login-page"},
      {id:"register-btn",chk:"register-page"},
      {id:"admin-btn",chk:"admin-login-page"}
    ];
    btnList.forEach(o=>document.getElementById(o.id).classList.remove("active"));
    let found = btnList.find(o=>o.chk===page);
    if(found) document.getElementById(found.id).classList.add("active");
  }
  document.getElementById("home-btn").onclick = function() { showPage("home"); };
  document.getElementById("login-btn").onclick = function() { showPage("login-page"); };
  document.getElementById("register-btn").onclick = function() { showPage("register-page"); };
  document.getElementById("admin-btn").onclick = function() { showPage("admin-login-page"); };
  function studentLogin() {
    const username = document.getElementById("student-username").value.trim();
    const password = document.getElementById("student-password").value;
    const user = users.find(u => u.username === username && u.password === password);
    if (user) {
      loggedInStudent = user;
      showPage("student-page");
    } else {
      document.getElementById("student-error").innerText = "Invalid credentials.";
    }
  }
  function registerUser() {
    const username = document.getElementById("register-username").value.trim();
    const password = document.getElementById("register-password").value;
    document.getElementById("register-error").innerText = "";
    document.getElementById("register-success").innerText = "";
    if (!username) {
      document.getElementById("register-error").innerText = "Username cannot be empty.";
      return;
    }
    if (users.find(u => u.username === username)) {
      document.getElementById("register-error").innerText = "Username exists.";
      return;
    }
    users.push({username, password});
    document.getElementById("register-success").innerText = "Registered! Please log in.";
    setTimeout(() => { showPage("login-page"); }, 1400);
  }
  function adminLogin() {
    const uname = document.getElementById("admin-username").value.trim();
    const pwd = document.getElementById("admin-password").value;
    if (uname === ADMIN_USERNAME && pwd === ADMIN_PASSWORD) {
      adminLoggedIn = true;
      showPage("admin-panel");
    } else {
      document.getElementById("admin-login-msg").innerText = "Wrong username or password.";
    }
  }
  function adminLogout() {
    adminLoggedIn = false;
    showPage("admin-login-page");
  }
  function showAdminNotes() {
    let html = "";
    notes.forEach((note, idx) => {
      html += `<div class="note">
        <b>${note.title}</b>
        <span class="${note.approved ? 'approved' : 'not-approved'}">
          ${note.approved ? 'Approved' : 'Pending'}
        </span>
        <button onclick="deleteNote(${idx})" style="background:#e57373;">Delete</button>
        ${!note.approved ? `<button onclick="approveNote(${idx})" style="background:#43aa8b; color:#fff;">Approve</button>` : ""}
      </div>`;
    });
    document.getElementById("admin-notes-list").innerHTML = html || "<em>No notes added.</em>";
  }
  function addNote() {
    const title = document.getElementById("note-title").value.trim();
    const link = document.getElementById("note-link").value.trim();
    if (title && link) {
      notes.push({title, link, approved: false});
      document.getElementById("note-title").value = "";
      document.getElementById("note-link").value = "";
      showAdminNotes();
    }
  }
  function approveNote(idx) {
    notes[idx].approved = true;
    showAdminNotes();
  }
  function deleteNote(idx) {
    notes.splice(idx, 1);
    showAdminNotes();
  }
  window.approveNote = approveNote;
  window.deleteNote = deleteNote;
  function showAdminUsers() {
    let html = `<tr><th>Username</th><th>Password</th></tr>`;
    users.forEach(u => {
      html += `<tr><td>${u.username}</td><td>${u.password ? u.password : "<em>(empty)</em>"}</td></tr>`;
    });
    document.getElementById("admin-users-list").innerHTML = html;
  }
  function showNotes() {
    let html = "";
    notes.forEach(note => {
      if (note.approved) {
        html += `<div class="note">
          <b>${note.title}</b>
          <a href="${note.link}" target="_blank" style="float:right;color:#1982c4;font-weight:bold;" download>Download</a>
        </div>`;
      }
    });
    document.getElementById("notes-list").innerHTML =
      html || "<em>No approved notes available. Check back later.</em>";
  }
  showPage("home");
</script>
</body>
</html>
